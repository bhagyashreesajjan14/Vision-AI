# ===============================================================
# AI Visual Quality Inspection System - Environment Configuration
# ===============================================================

# Django Secret Key & Debug Mode
SECRET_KEY=django-insecure-ai-visual-quality-inspection-hackathon-round2
DEBUG=True

# ---------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------
# Options for DB_ENGINE:
# - Leave blank or set to 'sqlite' for zero-setup SQLite database
# - Set to 'django.db.backends.mysql' for MySQL
# - Set to 'django.db.backends.postgresql' for PostgreSQL
DB_ENGINE=sqlite
DB_NAME=visual_inspection
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------------------------------------------------------------
# Celery & Redis Configuration
# ---------------------------------------------------------------
# Set Redis connection URL
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Set to True to execute batch tasks synchronously without Redis running,
# or False to use Celery worker background processing with Redis.
CELERY_TASK_ALWAYS_EAGER=False

